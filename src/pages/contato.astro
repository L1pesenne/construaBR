---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import QuoteForm from '../components/QuoteForm.astro';
import ContactButton from '../components/ContactButton.astro';
import FAQ from '../components/FAQ.astro';
import { company, whatsappUrl } from '../config/company';
import { regions } from '../data/navigation';
const available = Boolean(whatsappUrl());
---
<BaseLayout title="Contato e orçamento" description="Prepare seu orçamento de materiais a granel: informe material, quantidade e local de entrega para conversar com a ConstruaBR.">
  <PageIntro eyebrow="FALE COM A CONSTRUABR" title="Sua próxima obra começa aqui." description="Atendimento direto com Alessandro para alinhar material, volume e entrega. A negociação acontece pelo WhatsApp." />
  <div class="container contact-grid page-content">
    <QuoteForm />
    <aside class="contact-sidebar" aria-label="Atendimento e cobertura">
      <div class="contact-card dark-card"><span class="eyebrow">CONVERSA DIRETA</span><h2>Do primeiro contato ao pedido.</h2><p>Consulte a disponibilidade do material e combine as condições de fornecimento com {company.contactName}.</p>{available ? <ContactButton direct label="Conversar no WhatsApp" variant="green" /> : <p class="channel-note">WhatsApp oficial pendente. Prepare sua mensagem no formulário ao lado.</p>}{company.email && <p><strong>E-mail:</strong> <a class="contact-email" href={`mailto:${company.email}`}>{company.email}</a></p>}{company.businessHours && <p><strong>Horário:</strong> {company.businessHours}</p>}{company.address && <p><strong>Endereço:</strong> {company.address}</p>}{company.baseCity && <p><strong>Base:</strong> {company.baseCity}</p>}</div>
      <div class="contact-card"><span class="eyebrow">SUA OBRA NO RJ</span><h2>Consulte sua região.</h2><ul class="contact-regions">{regions.map(region => <li>{region}</li>)}</ul><p>Cada endereço depende da cobertura efetiva, do raio de até {company.serviceRadiusKm} km da base e das condições operacionais.</p><a class="text-link" href="/entregas/">Conhecer as condições de entrega →</a></div>
    </aside>
  </div>
  <FAQ />
</BaseLayout>
