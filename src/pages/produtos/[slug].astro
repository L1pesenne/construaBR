---
import { withBase } from '../../lib/paths';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactButton from '../../components/ContactButton.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import ProductCard from '../../components/ProductCard.astro';
import { company } from '../../config/company';
import { productRequestMessage } from '../../lib/quotation';
import { canPublishProduct } from '../../lib/catalog';
import { visibleProducts, type Product } from '../../data/products';
export const getStaticPaths = (() => visibleProducts.map(product => ({ params: { slug: product.slug }, props: { product } }))) satisfies GetStaticPaths;
interface Props { product: Product; }
const { product } = Astro.props;
const related = visibleProducts.filter(item => item.id !== product.id && item.category === product.category).slice(0, 2);
const approved = canPublishProduct(product);
---
<BaseLayout title={product.name} description={product.description} noindex={!approved} editorial>
  <div class="container material-page">
    <nav class="material-return" aria-label="Navegação do catálogo"><a class="editorial-link" href={withBase('/produtos/')}>← Voltar aos materiais</a></nav>
    <header class="material-heading"><span class="editorial-kicker">{product.category}</span><h1>{product.name}</h1></header>
    {!approved && <p class="catalog-disclosure"><strong>{product.confirmation === 'supplier-reference' ? 'Referência de fornecedor não aprovada.' : 'Demonstração de desenvolvimento.'}</strong> Material pendente de validação pela ConstruaBR. Esta página não confirma disponibilidade ou estoque.</p>}
    <div class="material-overview editorial-grid">
      <ProductGallery product={product} />
      <section class="material-summary" aria-label="Consulta comercial"><span class="editorial-kicker">{approved ? 'MATERIAL CONFIRMADO PELA CONSTRUABR' : 'REFERÊNCIA DOCUMENTAL'}</span><p class="material-introduction">{product.description}</p><dl><div><dt>Fornecimento</dt><dd>Exclusivamente a granel. Sem materiais ensacados ou fracionados.</dd></div><div><dt>Unidade de referência</dt><dd>{product.referenceUnit ?? 'A confirmar com a equipe no orçamento.'}</dd></div><div><dt>Transporte</dt><dd>Caminhões basculantes, dimensionados conforme o volume do pedido.</dd></div></dl><ContactButton materialSlug={product.slug} message={productRequestMessage(product.name)} /><p class="material-quote-note">Informe a quantidade aproximada e o endereço de entrega. O material já estará selecionado no formulário.</p><a class="editorial-link" href={withBase('/entregas/')}>Condições de entrega →</a></section>
    </div>
    <div class="material-information editorial-grid">
      <section class="material-description" aria-labelledby="description-title"><span class="editorial-kicker">SOBRE O MATERIAL</span><h2 id="description-title">Informação para<br />planejar seu pedido.</h2><p>{product.detailedDescription}</p><div class="material-source"><strong>Fonte documental</strong><span>{product.sourceDocument.label} · página {product.sourceDocument.page}.</span><span>{product.sourceDocument.kind === 'supplier-catalog' ? 'Catálogo de fornecedor; não comprova oferta pela ConstruaBR.' : 'Documento fornecido como referência. Aprovação comercial independente.'}</span></div></section>
      <section class="material-technical" aria-labelledby="technical-title"><span class="editorial-kicker">ESPECIFICAÇÕES</span><h2 id="technical-title">Características técnicas.</h2>{product.technicalCharacteristics.length ? <dl>{product.technicalCharacteristics.map(characteristic => <div><dt>{characteristic.label}</dt><dd>{characteristic.value}<small>Fonte: {characteristic.source}</small></dd></div>)}</dl> : <p>Não há características técnicas confirmadas para esta referência. Granulometria, especificações e adequação ao projeto precisam ser validadas com a equipe.</p>}</section>
    </div>
    <section class="material-logistics" aria-labelledby="supply-title"><span class="editorial-kicker">DO MATERIAL À SUA OBRA</span><h2 id="supply-title">O volume define a logística.</h2><dl><div><dt>01 / Transporte</dt><dd>Exclusivamente em caminhões basculantes. Dimensionamento conforme o volume aprovado.</dd></div><div><dt>02 / Prazo</dt><dd>Entrega em {company.deliveryHours} horas após aprovação pelo WhatsApp, conforme as condições operacionais.</dd></div><div><dt>03 / Cobertura</dt><dd>Raio máximo de {company.serviceRadiusKm} km da base. Atendimento condicionado à cobertura efetiva e ao acesso à obra.</dd></div></dl></section>
    {related.length > 0 && <section class="material-related" aria-labelledby="related-title"><header><div><span class="editorial-kicker">NA MESMA CATEGORIA</span><h2 id="related-title">Outras referências.</h2></div><a class="editorial-link" href={withBase('/produtos/')}>Ver catálogo →</a></header><div class="catalog-grid">{related.map(item => <ProductCard product={item} />)}</div></section>}
  </div>
</BaseLayout>
