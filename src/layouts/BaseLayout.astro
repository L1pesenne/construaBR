---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import EditorialFooter from '../components/EditorialFooter.astro';
import { company } from '../config/company';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/public-sans/latin-400.css';
import '@fontsource/public-sans/latin-500.css';
import '@fontsource/public-sans/latin-600.css';
import '../styles/global.css';
import '../styles/home.css';
import '../styles/catalog.css';
import '../styles/institutional.css';
import '../styles/editorial.css';
interface Props { title: string; description?: string; noindex?: boolean; editorial?: boolean; }
const { title, description = 'Distribuição de materiais de construção exclusivamente a granel no Rio de Janeiro. Transporte em caminhões basculantes e orçamento pelo WhatsApp.', noindex = false, editorial = false } = Astro.props;
const canonical = company.domain ? new URL(Astro.url.pathname, company.domain).href : undefined;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1F2529" />
    <title>{title} | ConstruaBR Distribuidora</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex || !company.domain ? 'noindex, nofollow' : 'index, follow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={`${title} | ConstruaBR`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
  </head>
  <body class:list={{ 'corporate-home': editorial }}><a class="skip-link" href="#conteudo">Pular para o conteúdo</a><Header /><main id="conteudo" tabindex="-1"><slot /></main>{editorial ? <EditorialFooter /> : <Footer />}<FloatingContact /></body>
</html>
