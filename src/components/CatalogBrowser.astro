---
import type { Product } from '../data/products';
import ProductCard from './ProductCard.astro';
import Icon from './Icon.astro';
interface Props { products: Product[]; }
const { products } = Astro.props;
const categories = [...new Set(products.map(product => product.category))].sort((a, b) => a.localeCompare(b, 'pt-BR'));
---
<div class="catalog-browser" data-catalog>
  <form class="catalog-controls" data-catalog-controls hidden role="search" aria-label="Buscar e filtrar materiais">
    <div class="catalog-search"><label for="material-search">Qual material você procura?</label><div class="search-field"><Icon name="search" size={22} /><input id="material-search" name="q" type="search" placeholder="Busque por nome ou aplicação" autocomplete="off" aria-controls="catalog-results" /></div></div>
    <fieldset class="category-filters"><legend>Filtrar por categoria <span>Selecione uma ou mais</span></legend><div class="category-options">{categories.map(category => <label class="category-option"><input type="checkbox" name="categoria" value={category} aria-controls="catalog-results" /><span>{category}</span></label>)}</div></fieldset>
  </form>
  <noscript><p class="catalog-help">Todos os materiais estão listados abaixo. Ative o JavaScript para pesquisar e combinar filtros.</p></noscript>
  <div class="catalog-results-bar"><p role="status" aria-live="polite" aria-atomic="true" data-results-count>{products.length} {products.some(product => product.status === 'demo') ? 'referências em demonstração' : 'materiais'}</p><button type="button" class="clear-filters" data-clear-filters hidden>Limpar filtros</button></div>
  <div class="catalog-grid" id="catalog-results">
    {products.map(product => <div class="catalog-item" data-catalog-item data-category={product.category} data-search-text={`${product.name} ${product.category} ${product.description} ${product.detailedDescription}`}><ProductCard product={product} /></div>)}
  </div>
  <div class="catalog-empty" data-catalog-empty hidden><Icon name="search" size={36} /><h2>Nenhum material encontrado.</h2><p>Tente outro termo ou remova uma categoria para ampliar a busca.</p><button type="button" class="button button-outline" data-clear-empty>Limpar busca e filtros</button></div>
</div>
<script>
  import { matchesCatalogFilter } from '../lib/catalog';
  const catalog = document.querySelector<HTMLElement>('[data-catalog]');
  if (catalog) {
    const form = catalog.querySelector<HTMLFormElement>('form')!;
    const search = form.querySelector<HTMLInputElement>('input[type="search"]')!;
    const checkboxes = Array.from(form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));
    const items = Array.from(catalog.querySelectorAll<HTMLElement>('[data-catalog-item]'));
    const count = catalog.querySelector<HTMLElement>('[data-results-count]')!;
    const empty = catalog.querySelector<HTMLElement>('[data-catalog-empty]')!;
    const clear = catalog.querySelector<HTMLButtonElement>('[data-clear-filters]')!;
    function applyFilters(updateUrl = true) {
      const categories = checkboxes.filter(input => input.checked).map(input => input.value);
      let visible = 0;
      for (const item of items) {
        const match = matchesCatalogFilter(item.dataset.searchText ?? '', item.dataset.category ?? '', search.value, categories);
        item.hidden = !match;
        if (match) visible++;
      }
      const demo = !!document.querySelector('.catalog-disclosure');
      count.textContent = `${visible} ${demo ? (visible === 1 ? 'referência em demonstração' : 'referências em demonstração') : (visible === 1 ? 'material encontrado' : 'materiais encontrados')}${search.value.trim() || categories.length ? ` de ${items.length}` : ''}`;
      empty.hidden = visible !== 0;
      clear.hidden = !search.value && !categories.length;
      if (updateUrl) {
        const url = new URL(location.href);
        url.searchParams.delete('q');
        url.searchParams.delete('categoria');
        if (search.value.trim()) url.searchParams.set('q', search.value.trim());
        categories.forEach(category => url.searchParams.append('categoria', category));
        history.replaceState(null, '', url);
      }
    }
    function readUrl() {
      const params = new URLSearchParams(location.search);
      search.value = params.get('q') ?? '';
      const categories = params.getAll('categoria');
      checkboxes.forEach(input => { input.checked = categories.includes(input.value); });
      applyFilters(false);
    }
    function resetFilters() {
      form.reset();
      applyFilters();
      search.focus();
    }
    search.addEventListener('input', () => applyFilters());
    form.addEventListener('change', () => applyFilters());
    form.addEventListener('submit', event => { event.preventDefault(); applyFilters(); });
    clear.addEventListener('click', resetFilters);
    catalog.querySelector('[data-clear-empty]')?.addEventListener('click', resetFilters);
    window.addEventListener('popstate', readUrl);
    form.hidden = false;
    readUrl();
  }
</script>
