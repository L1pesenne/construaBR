---
import { withBase } from '../lib/paths';
import ContactButton from './ContactButton.astro';
import Icon from './Icon.astro';
import LocalImage from './LocalImage.astro';
---
<section class="editorial-hero" aria-labelledby="hero-title">
  <div class="container editorial-grid">
    <div class="editorial-hero-copy">
      <span class="editorial-kicker">CONSTRUABR DISTRIBUIDORA · RIO DE JANEIRO</span>
      <h1 id="hero-title"><span>Materiais a granel.</span><span>Logística para</span><span>sua obra.</span></h1>
      <p>Fornecimento de materiais de construção no Rio de Janeiro, com transporte por caminhões basculantes e atendimento comercial direto.</p>
      <div class="editorial-hero-actions"><ContactButton /><a class="editorial-link" href="#materiais">Conhecer materiais<Icon name="arrow" size={19} /></a></div>
      <a class="editorial-about-link" href={withBase('/sobre/')}>Conheça a ConstruaBR <span aria-hidden="true">↗</span></a>
    </div>
    <figure class="editorial-hero-photo">
      <LocalImage asset="areia-lavada" alt="Textura de areia a granel em fotografia original fornecida pela ConstruaBR" sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1199px) 54vw, 760px" priority />
      <figcaption><span>MATERIAIS A GRANEL</span><span>Fotografia fornecida · referência visual</span></figcaption>
    </figure>
  </div>
</section>
