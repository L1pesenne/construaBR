---
import { withBase } from '../lib/paths';
import Logo from './Logo.astro';
import { navigation, regions } from '../data/navigation';
import { company, whatsappUrl } from '../config/company';
const contact = whatsappUrl();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div><Logo light /><p>Materiais a granel. Logística para sua obra.<br />Atendimento direto no Rio de Janeiro.</p><span class="footer-note">Vendas exclusivamente a granel.<br />Não trabalhamos com produtos ensacados ou fracionados.</span></div>
    <div><h2>Explore</h2><ul>{navigation.map(link => <li><a href={withBase(link.href)}>{link.label}</a></li>)}</ul></div>
    <div><h2>Regiões de destaque</h2><ul>{regions.map(region => <li>{region}</li>)}</ul><p class="footer-note">Sujeitas ao raio de {company.serviceRadiusKm} km da base.</p></div>
    <div><h2>Vamos conversar</h2><p>Atendimento com {company.contactName}.</p><a class="footer-contact" href={withBase(contact ?? '/contato/#atendimento')}>{contact ? 'Fale pelo WhatsApp ↗' : 'Informações de contato →'}</a>{company.businessHours && <p>{company.businessHours}</p>}{company.address && <p>{company.address}</p>}{company.socialLinks.map(link => <p><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a></p>)}</div>
  </div>
  <div class="container footer-bottom"><span>© <span data-year>{new Date().getFullYear()}</span> {company.name}.</span><span>Da base à sua obra.</span></div>
</footer>
<script>document.querySelectorAll('[data-year]').forEach(el => { el.textContent = String(new Date().getFullYear()); });</script>
