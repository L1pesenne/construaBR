---
import { withBase } from '../lib/paths';
interface Props { light?: boolean; }
const { light = false } = Astro.props;
---
<a href={withBase('/')} class:list={['brand', { 'brand-light': light }]} aria-label="ConstruaBR Distribuidora — início">
  <img src={withBase('/images/brand/construabr.svg')} alt="ConstruaBR" width="718" height="108" />
  <span class="brand-subtitle">DISTRIBUIDORA</span>
</a>
