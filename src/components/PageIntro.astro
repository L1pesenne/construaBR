---
import { withBase } from '../lib/paths';
interface Props { title: string; eyebrow: string; description?: string; }
const { title, eyebrow, description } = Astro.props;
---
<div class="container page-intro"><nav class="breadcrumbs" aria-label="Caminho de navegação"><a href={withBase('/')}>Início</a><span aria-hidden="true"> / </span><span aria-current="page">{eyebrow}</span></nav><span class="eyebrow">{eyebrow}</span><h1>{title}</h1>{description && <p>{description}</p>}</div>
